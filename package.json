{
  "name": "football-sim",
  "version": "1.0.0",
  "description": "Football Simulation Lab",
  "scripts": {
    "build": "node build.js",
    "check": "for f in js/*.js; do node --check \"$f\" || exit 1; done && echo '✅ 構文チェック全緑'",
    "test:fn00": "node tools/fn00-names-test.js",
    "check:docs": "node tools/docs-guard.js",
    "regression": "node tools/regression-harness.js check",
    "regression:full": "node tools/regression-harness.js check 1500",
    "deploy:guard": "node tools/deploy-guard.js",
    "deploy:lab": "node tools/docs-guard.js && node tools/deploy-guard.js && npx --yes wrangler@4 pages deploy dist-lab --project-name=kantoku-lab --branch=main --commit-dirty=true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/footballsim/football-sim.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "javascript-obfuscator": "^5.4.3",
    "sharp": "^0.35.1"
  }
}
