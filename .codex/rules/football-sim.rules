# football-sim standing delegation (2026-08-14 user decision).
# Project-local rules load when this repository's .codex layer is trusted.

prefix_rule(pattern = ["git", "worktree", "add"], decision = "prompt", justification = "Use npm run delegated:worktree")
prefix_rule(pattern = ["git", "add"], decision = "prompt", justification = "Use npm run delegated:stage")
prefix_rule(pattern = ["git", "commit"], decision = "prompt", justification = "Use npm run delegated:commit")
prefix_rule(pattern = ["git", "merge"], decision = "prompt", justification = "Use npm run delegated:merge")
prefix_rule(pattern = ["git", "push"], decision = "prompt", justification = "Use npm run delegated:push")
prefix_rule(pattern = ["git", "restore"], decision = "prompt", justification = "Use npm run delegated:restore-docs for build byproducts")

prefix_rule(
    pattern = ["npm", "run", ["delegated:worktree", "delegated:stage", "delegated:commit", "delegated:merge", "delegated:push", "delegated:restore-docs"]],
    decision = "allow",
    justification = "Validated fixed-argument git gateways for standing delegation",
)

prefix_rule(
    pattern = ["git", "add", "."],
    decision = "forbidden",
    justification = "Use explicit file paths; docs and unrelated drafts must never be swept in",
)

prefix_rule(
    pattern = ["git", "add", "-A"],
    decision = "forbidden",
    justification = "Use explicit file paths; docs and unrelated drafts must never be swept in",
)

prefix_rule(
    pattern = ["git", "add", "--all"],
    decision = "forbidden",
    justification = "Use explicit file paths; docs and unrelated drafts must never be swept in",
)

prefix_rule(
    pattern = ["npm", "run", ["build", "deploy:guard", "deploy:lab"]],
    decision = "allow",
    justification = "Only guarded project scripts may build or deploy the private lab",
)

prefix_rule(pattern = ["git", "reset"], decision = "forbidden", justification = "Never discard user work; use a new worktree or ask")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden", justification = "Never delete untracked user work")
prefix_rule(pattern = ["git", "checkout", "--"], decision = "forbidden", justification = "Never discard user work with checkout --")

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Force push is outside standing delegation",
)

prefix_rule(
    pattern = ["git", "push", "origin", "game-main", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Force push is outside standing delegation",
)

prefix_rule(
    pattern = ["git", "push", "origin", "main"],
    decision = "forbidden",
    justification = "main and football-sim.com are frozen archives; use game-main",
)

prefix_rule(pattern = ["git", "push", "origin", "HEAD:main"], decision = "forbidden", justification = "main is frozen")
prefix_rule(pattern = ["git", "push", "origin", "game-main:main"], decision = "forbidden", justification = "main is frozen")
prefix_rule(pattern = ["git", "push", "origin", "refs/heads/main"], decision = "forbidden", justification = "main is frozen")
prefix_rule(pattern = ["git", "push", "origin", "HEAD:refs/heads/main"], decision = "forbidden", justification = "main is frozen")
prefix_rule(pattern = ["git", "push", "origin", "game-main:refs/heads/main"], decision = "forbidden", justification = "main is frozen")

prefix_rule(pattern = ["npx"], decision = "forbidden", justification = "Use a reviewed package.json script; direct external CLI execution is forbidden")
prefix_rule(pattern = ["npm", "exec"], decision = "forbidden", justification = "Use a reviewed package.json script; direct external CLI execution is forbidden")
prefix_rule(pattern = ["wrangler"], decision = "forbidden", justification = "Use npm run deploy:lab")
prefix_rule(pattern = ["./node_modules/.bin/wrangler"], decision = "forbidden", justification = "Use npm run deploy:lab")
prefix_rule(pattern = ["node_modules/.bin/wrangler"], decision = "forbidden", justification = "Use npm run deploy:lab")
